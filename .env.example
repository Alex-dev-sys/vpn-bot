# VPN Bot 2.0 Configuration

# === ОБЯЗАТЕЛЬНО ===
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_id

# === ОПЦИОНАЛЬНО ===
# Карта для оплаты (номер карты)
PAYMENT_CARD=1234567890123456

# Username бота (без @)
BOT_USERNAME=your_bot_username

# === ПЛАТЕЖНЫЕ СИСТЕМЫ (опционально) ===
# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Telegram Stars
ENABLE_STARS=false
